# Virtual Environment
.venv/
venv/
ENV/
env/

# Python Cache
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Large media files (CCTV recordings >100MB cannot be pushed to GitHub)
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.flv
*.ts

# Exception: allow small demo clip or keep demo folder structure
!demo/.gitkeep

# Datasets and Screenshots (keep dataset directory structure via .gitkeep)
dataset/
screenshots/
results/
runs/
*.csv

# YOLO / PyTorch model weights (downloaded automatically at runtime)
*.pt
*.onnx
*.engine

# Environment & local settings
.env
.env.*
.DS_Store
Thumbs.db
